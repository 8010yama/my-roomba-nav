<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roomba_nav</name>
  <version>0.1.0</version>
  <description>Self-made Roomba: robot bringup (drive base + LD19 LiDAR + Pro Controller) SLAM + Nav2 navigation, and navigation on a saved map (map_server + AMCL).</description>
  <maintainer email="pokimaruy8@gmail.com">alia</maintainer>
  <license>MIT</license>
  <exec_depend>pico_bridge</exec_depend>
  <exec_depend>ldlidar_stl_ros2</exec_depend>
  <exec_depend>laser_tools</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>roomba_tasks</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
